#!/data/data/com.termux/files/usr/bin/bash
# claude-musl — run Claude Code's musl build natively on Termux, with no glibc.
#
# Why this exists: the stock `claude` here is a bionic stub that execs the glibc
# loader (449MB of glibc) with claude.glibc. That works, but /proc/self/exe then
# points at the loader, which disables the upstream updater and breaks Claude
# Code's own grep/find/pkill shell shims. This runs the musl build directly —
# its interpreter was repointed with patchelf at $PREFIX/lib/ld-musl-aarch64.so.1
# (723KB) — so /proc/self/exe is the binary itself and those work again.
#
# DNS still needs help: musl reads /etc/resolv.conf, which Android does not have,
# so we start a small proxy on the bionic side (termux-http-proxy) and point the
# binary at it.
#
#   CLAUDE_MUSL_NO_PROXY=1   use the ambient proxy settings instead of starting one
#   TERMUX_PROXY_TOKEN_FILE  proxy token (default ~/.config/termux-http-proxy/token)
#
set -uo pipefail

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
LIBEXEC="$PREFIX/libexec/claude-musl"
BIN="$LIBEXEC/claude"

[ -x "$BIN" ] || { echo "claude-musl: missing $BIN" >&2; exit 1; }

export SSL_CERT_FILE="${SSL_CERT_FILE:-$PREFIX/etc/tls/cert.pem}"
# The upstream updater would fetch the linux-arm64 *glibc* build over this one.
# Updates go through the existing claude-termux-update / a fresh musl install.
export DISABLE_AUTOUPDATER=1

die() { echo "claude-musl: $*" >&2; exit 1; }

# The proxy can require a token (--auth-file): Android's loopback is reachable by every
# app on the device, so without one any app could use it as an open relay. The token
# lives where only Termux can read it. Credentials sent to a proxy that does not ask
# for them are ignored, so this works whether or not the shared daemon requires them.
PROXY_TOKEN_FILE="${TERMUX_PROXY_TOKEN_FILE:-$HOME/.config/termux-http-proxy/token}"
proxy_url() {
  local token=""
  [ -r "$PROXY_TOKEN_FILE" ] && token="$(tr -d '[:space:]' < "$PROXY_TOKEN_FILE")"
  if [ -n "$token" ]; then
    printf 'http://proxy:%s@127.0.0.1:%s' "$token" "$1"
  else
    printf 'http://127.0.0.1:%s' "$1"
  fi
}

PROXY_PID=""
# Not named PROXY, because `coproc PROXY` would make bash own a variable of this name
# and unset it when the coprocess is reaped — taking our snapshot with it.
cleanup() { [ -n "${PROXY_PID:-}" ] && kill "$PROXY_PID" 2>/dev/null; return 0; }
trap cleanup EXIT INT TERM

if [ -z "${CLAUDE_MUSL_NO_PROXY:-}" ]; then
  # If a proxy is already configured in the environment, use it directly.
  if [ -n "${HTTP_PROXY:-${http_proxy:-}}" ]; then
    export CLAUDE_CODE_PROXY_RESOLVES_HOSTS=true
  # If a shared daemon is already active on localhost:18080, reuse it without spawning a process.
  elif nc -z 127.0.0.1 18080 2>/dev/null; then
    export http_proxy="$(proxy_url 18080)"
    export https_proxy="$http_proxy"
    export HTTP_PROXY="$http_proxy"
    export HTTPS_PROXY="$http_proxy"
    export all_proxy="$http_proxy"
    export CLAUDE_CODE_PROXY_RESOLVES_HOSTS=true
  else
    # The C proxy is the default: same contract, same stdout line, but ~2.8MB RSS against
    # bun's ~45MB and one thread against four. The JS version stays beside it as the
    # fallback, so a toolchain-less install (or a bad build) still works.
    #
    # CLAUDE_MUSL_RUNTIME=bun|node forces the JS path.
    RUNTIME="${CLAUDE_MUSL_RUNTIME:-}"
    if [ -z "$RUNTIME" ] && [ -x "$LIBEXEC/termux-http-proxy" ]; then
      # Creates the token (random, 0600) on first use; the JS fallback has no --auth-file.
      mkdir -p "${PROXY_TOKEN_FILE%/*}" && chmod 700 "${PROXY_TOKEN_FILE%/*}"
      PROXY_CMD=("$LIBEXEC/termux-http-proxy" --auth-file "$PROXY_TOKEN_FILE")
    else
      [ -n "$RUNTIME" ] || { command -v bun >/dev/null 2>&1 && RUNTIME=bun || RUNTIME=node; }
      command -v "$RUNTIME" >/dev/null 2>&1 || die "need bun or node for the proxy (pkg install bun)"
      PROXY_CMD=("$RUNTIME" "$LIBEXEC/termux-http-proxy.js")
    fi

    # A coprocess rather than a fifo: it needs no mkfifo binary, and bash hands back both
    # the pipe and the pid. Reading one line blocks until the proxy reports its port.
    coproc HTTPPROXY { exec "${PROXY_CMD[@]}"; }
    PROXY_PID="${HTTPPROXY_PID:-}"
    PORT=""
    if [ -n "${HTTPPROXY[0]:-}" ]; then
      read -r -t 15 PORT <&"${HTTPPROXY[0]}" || true
    fi

    if [ -n "$PORT" ]; then
      if [ "${PROXY_CMD[0]}" = "$LIBEXEC/termux-http-proxy" ]; then
        export http_proxy="$(proxy_url "$PORT")"
      else
        export http_proxy="http://127.0.0.1:$PORT"
      fi
      export https_proxy="$http_proxy"
      export HTTP_PROXY="$http_proxy"
      export HTTPS_PROXY="$http_proxy"
      export all_proxy="$http_proxy"
      export CLAUDE_CODE_PROXY_RESOLVES_HOSTS=true
    else
      cleanup; PROXY_PID=""
      die "the proxy did not start; set CLAUDE_MUSL_NO_PROXY=1 to run without it anyway"
    fi
  fi
fi

# Termux's interactive shells set LD_PRELOAD to libtermux-exec-ld-preload.so, which is
# a *bionic* library: musl's loader tries to relocate it and dies on __register_atfork,
# __errno, the fortify symbols and so on. Drop it for the binary only — the node proxy
# above still starts under the normal environment. The glibc launcher does the same,
# which is why shells started from Claude Code here already have no LD_PRELOAD.
env -u LD_PRELOAD "$BIN" "$@"
status=$?
cleanup
PROXY_PID=""
exit $status
