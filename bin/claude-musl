#!/data/data/com.termux/files/usr/bin/bash
# claude-musl — run Claude Code's musl build natively on Termux, with no glibc.
#
# Why this exists: the stock `claude` here is a bionic stub that execs the glibc
# loader (449MB of glibc) with claude.glibc. That works, but /proc/self/exe then
# points at the loader, which disables the upstream updater and breaks Claude
# Code's own grep/find/pkill shell shims. This runs the musl build directly —
# its interpreter was repointed with patchelf at $PREFIX/lib/ld-musl-aarch64.so.1
# (723KB) — so /proc/self/exe is the binary itself and those work again.
#
# DNS still needs help: musl reads /etc/resolv.conf, which Android does not have,
# so we start a small proxy on the bionic side and point the binary at it.
#
#   CLAUDE_MUSL_NO_PROXY=1   use the ambient proxy settings instead of starting one
#
set -uo pipefail

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
LIBEXEC="$PREFIX/libexec/claude-musl"
BIN="$LIBEXEC/claude"

[ -x "$BIN" ] || { echo "claude-musl: missing $BIN" >&2; exit 1; }

export SSL_CERT_FILE="${SSL_CERT_FILE:-$PREFIX/etc/tls/cert.pem}"
# The upstream updater would fetch the linux-arm64 *glibc* build over this one.
# Updates go through the existing claude-termux-update / a fresh musl install.
export DISABLE_AUTOUPDATER=1

die() { echo "claude-musl: $*" >&2; exit 1; }

PROXY_PID=""
cleanup() { [ -n "$PROXY_PID" ] && kill "$PROXY_PID" 2>/dev/null; }
trap cleanup EXIT INT TERM

if [ -z "${CLAUDE_MUSL_NO_PROXY:-}" ]; then
  # Either runtime runs the proxy unchanged, but bun boots in ~30ms against node's
  # ~290ms on this device, and that cost is paid on every launch. Both are bionic
  # builds, which is the part that matters: only bionic can ask Android for a resolver.
  RUNTIME="${CLAUDE_MUSL_RUNTIME:-}"
  [ -n "$RUNTIME" ] || { command -v bun >/dev/null 2>&1 && RUNTIME=bun || RUNTIME=node; }
  command -v "$RUNTIME" >/dev/null 2>&1 || die "need bun or node for the DNS proxy (pkg install bun)"

  # A coprocess rather than a fifo: it needs no mkfifo binary, and bash hands back both
  # the pipe and the pid. Reading one line blocks until the proxy reports its port.
  coproc PROXY { "$RUNTIME" "$LIBEXEC/dns-proxy.js"; }
  PROXY_PID=$PROXY_PID
  PORT=""
  read -r -t 15 PORT <&"${PROXY[0]}" || true

  if [ -n "$PORT" ]; then
    export http_proxy="http://127.0.0.1:$PORT"
    export https_proxy="$http_proxy"
    export HTTP_PROXY="$http_proxy"
    export HTTPS_PROXY="$http_proxy"
    export all_proxy="$http_proxy"
    export CLAUDE_CODE_PROXY_RESOLVES_HOSTS=true
  else
    # Without it, DNS inside the musl process hangs for minutes rather than failing,
    # which is a worse experience than stopping here.
    cleanup; PROXY_PID=""
    die "the DNS proxy did not start; set CLAUDE_MUSL_NO_PROXY=1 to run without it anyway"
  fi
fi

# Termux's interactive shells set LD_PRELOAD to libtermux-exec-ld-preload.so, which is
# a *bionic* library: musl's loader tries to relocate it and dies on __register_atfork,
# __errno, the fortify symbols and so on. Drop it for the binary only — the node proxy
# above still starts under the normal environment. The glibc launcher does the same,
# which is why shells started from Claude Code here already have no LD_PRELOAD.
env -u LD_PRELOAD "$BIN" "$@"
status=$?
cleanup
PROXY_PID=""
exit $status
